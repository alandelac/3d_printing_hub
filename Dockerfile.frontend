# Etapa 1: Compilar Blazor WebAssembly
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/3DPrintingHub.Client/3DPrintingHub.Client.csproj ./3DPrintingHub.Client/
RUN dotnet restore ./3DPrintingHub.Client/3DPrintingHub.Client.csproj

COPY src/ ./
WORKDIR /src/3DPrintingHub.Client
RUN dotnet publish ./3DPrintingHub.Client.csproj -c Release -o /app/publish

# Etapa 2: Servir con Nginx
FROM nginx:alpine AS final
WORKDIR /usr/share/nginx/html
COPY --from=build /app/publish/wwwroot .
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]